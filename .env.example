NODE_ENV=development
PORT=4000
# docker compose (docs/ARCHITECTURE.md "로컬 인프라")
DATABASE_URL=postgresql://sjyc:sjyc@localhost:5434/sjyc
DATABASE_URL_TEST=postgresql://sjyc:sjyc@localhost:5434/sjyc_test
REDIS_URL=redis://localhost:6381
REDIS_URL_TEST=redis://localhost:6381/15
# 웹 주소(쉼표로 여러 개). CORS·CSRF Origin 검사에 쓴다
WEB_ORIGIN=http://localhost:3000
# 메일 본문 링크(비밀번호 재설정 등)에 쓰는 웹 주소
WEB_PUBLIC_URL=http://localhost:3000
# 이메일 인증 링크 등 API 를 가리키는 공개 주소 (/api/v1 포함)
API_PUBLIC_URL=http://localhost:4000/api/v1
# 웹과 API 가 하위 도메인으로 나뉘면 상위 도메인(.example.kr)을 지정한다. 비우면 요청 호스트 기준
COOKIE_DOMAIN=
# 메일 (로컬 Mailpit: http://localhost:8026). 비우면 보내지 않고 로그로 남긴다 — 운영은 필수
SMTP_URL=smtp://localhost:1026
MAIL_FROM="중구청소년센터 <no-reply@localhost>"
# 세션 유효 시간(시간). 사용 중이면 절반이 지났을 때 연장된다
SESSION_TTL_HOURS=12

# 소셜 승인 콜백: API_PUBLIC_URL/auth/social/{provider}/callback
# Apple은 Services ID와 서버에서 서명한 기간 내 client secret을 사용합니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Services ID와 같은 개발자 팀의 Sign in with Apple 키. 설정하면 매 교환 시 ES256 JWT를 서명합니다.
# Apple에 등록한 사용자 iOS 앱의 Bundle ID
APPLE_IOS_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 플랫폼별 실계정 로그인을 확인한 뒤 on으로 변경
APPLE_WEB_LOGIN_ENABLED=off
APPLE_IOS_LOGIN_ENABLED=off
# 격리된 개발 환경의 가입 화면 검수용. 운영에서는 off만 허용
SIGNUP_PREVIEW_CODE=off

# 휴대전화 가입 인증. 운영은 등록된 문자 발신번호를 사용한다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
