// 데이터 모델 — 웹 저장소의 도메인 타입(src/shared/domain/types.ts)과 1:1 로 맞춘다.
// 열거형 값은 도메인 문자열과 같게(소문자) 두어 응답 변환을 단순하게 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───── 회원·인증 ─────

enum Role {
  member
  staff
  admin
  developer
}

enum UserStatus {
  active
  suspended
  withdrawn
}

enum OAuthProvider {
  kakao
  naver
  apple
  google
}

model User {
  id            String          @id @default(cuid())
  /// 소문자로 저장한다
  email         String          @unique
  name          String
  phone         String?
  birthYear     Int?
  /// argon2id. 소셜 로그인 전용 계정은 비어 있다
  passwordHash  String?
  roles         Role[]          @default([member])
  status        UserStatus      @default(active)
  emailVerified Boolean         @default(false)
  providers     OAuthProvider[] @default([])
  /// ConsentRecord[] — 약관·개인정보·마케팅 동의 이력
  consents      Json            @default("[]")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sessions      Session[]
  authTokens    AuthToken[]
  notifications Notification[]
  applications  ProgramApplication[]
  reservations  SpaceReservation[]
}

/// 로그인 세션 — 쿠키에는 원문 토큰, DB 에는 SHA-256 해시만 둔다
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthTokenPurpose {
  verify_email
  reset_password
}

/// 이메일 인증·비밀번호 재설정 1회용 토큰 (해시만 저장)
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
}

// ───── 알림 ─────

enum NotificationKind {
  application
  reservation
  club_application
  club_manager
  inquiry
  notice
}

/// 처리 결과(승인·반려·답변 등)를 본인에게 알리는 항목. 읽지 않은 수는 readAt 이 null 인 것
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  /// 서비스 내부 경로 (예: /my/applications/a-1)
  link      String
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

// ───── 프로그램 ─────

enum PublishStatus {
  draft
  published
  hidden
}

enum ApplicationStatus {
  submitted
  approved
  rejected
  cancelled
}

model ProgramCategory {
  id        String    @id
  name      String
  group     String
  sortOrder Int       @default(0)
  programs  Program[]
}

model Program {
  id              String               @id @default(cuid())
  title           String
  categoryId      String
  category        ProgramCategory      @relation(fields: [categoryId], references: [id])
  summary         String
  description     String
  target          String
  place           String
  startsAt        DateTime
  endsAt          DateTime
  recruitStartsAt DateTime
  recruitEndsAt   DateTime
  capacity        Int
  /// 접수·승인 상태 신청 수 (신청·취소·반려와 같은 트랜잭션에서 갱신)
  appliedCount    Int                  @default(0)
  status          PublishStatus        @default(draft)
  cancelDeadline  DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  applications    ProgramApplication[]

  @@index([status, recruitEndsAt])
}

model ProgramApplication {
  id            String            @id @default(cuid())
  /// 서버가 발급한 접수 번호 (SJYC-연도-일련번호)
  receiptNo     String            @unique
  programId     String
  program       Program           @relation(fields: [programId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantName String
  phone         String
  note          String
  status        ApplicationStatus @default(submitted)
  /// StatusHistoryEntry[]
  history       Json              @default("[]")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([programId, status])
  @@index([userId, createdAt])
}

enum ReservationStatus {
  pending
  approved
  rejected
  cancelled
}

model Space {
  id           String             @id @default(cuid())
  name         String
  floor        String
  capacity     Int
  description  String
  /// 예약 접수 여부 (휴관·점검 시 관리자가 끈다)
  reservable   Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  reservations SpaceReservation[]
}

model SpaceReservation {
  id            String            @id @default(cuid())
  spaceId       String
  space         Space             @relation(fields: [spaceId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantName String
  /// 하이픈 없는 숫자만
  phone         String
  /// 이용일 YYYY-MM-DD (KST 달력 날짜)
  date          String
  /// HH:MM
  startTime     String
  endTime       String
  headcount     Int
  purpose       String
  status        ReservationStatus @default(pending)
  reason        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([spaceId, date, status])
  @@index([userId, date])
}
