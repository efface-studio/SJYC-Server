// 데이터 모델 — 웹 저장소의 도메인 타입(src/shared/domain/types.ts)과 1:1 로 맞춘다.
// 열거형 값은 도메인 문자열과 같게(소문자) 두어 응답 변환을 단순하게 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───── 회원·인증 ─────

enum Role {
  member
  staff
  admin
  developer
}

enum UserStatus {
  active
  suspended
  withdrawn
}

enum OAuthProvider {
  kakao
  naver
  apple
  google
}

model User {
  id            String          @id @default(cuid())
  /// 소문자로 저장한다
  email         String          @unique
  name          String
  phone         String?
  birthYear     Int?
  birthDate     DateTime?       @db.Date
  /// argon2id. 소셜 로그인 전용 계정은 비어 있다
  passwordHash  String?
  roles         Role[]          @default([member])
  status        UserStatus      @default(active)
  signupPhoneVerifiedAt DateTime?
  /// 번호 소유 확인 없이 신규 일반회원 가입만 완료한 시각
  temporarySignupAt DateTime?
  emailVerified Boolean         @default(false)
  providers     OAuthProvider[] @default([])
  /// ConsentRecord[] — 약관·개인정보·마케팅 동의 이력
  consents      Json            @default("[]")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  socialIdentities SocialIdentity[]
  profilePhoto       UserProfilePhoto?
  sessions           Session[]
  authTokens         AuthToken[]
  mutedNotifications MutedNotification[]
  notifications      Notification[]
  applications       ProgramApplication[]
  reservations       SpaceReservation[]
  memberships        ClubMembership[]
  clubApplications   ClubApplication[]
  inquiries          Inquiry[]
  managedClubs       ClubManager[]
  attendance         AttendanceRecord[]
}

model SocialIdentity {
  userId   String
  provider OAuthProvider
  subject  String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@unique([provider, subject])
}

model UserProfilePhoto {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  image  String @db.Text
}

/// 로그인 세션 — 쿠키에는 원문 토큰, DB 에는 SHA-256 해시만 둔다
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  remembered Boolean @default(false)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AuthTokenPurpose {
  verify_email
  reset_password
}

/// 이메일 인증·비밀번호 재설정 1회용 토큰 (해시만 저장)
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
}

// ───── 알림 ─────

enum NotificationKind {
  application
  reservation
  club_application
  club_manager
  inquiry
  notice
}

model MutedNotification {
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind

  @@id([userId, kind])
}

/// 처리 결과(승인·반려·답변 등)를 본인에게 알리는 항목. 읽지 않은 수는 readAt 이 null 인 것
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  /// 서비스 내부 경로 (예: /my/applications/a-1)
  link      String
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

// ───── 프로그램 ─────

enum PublishStatus {
  draft
  published
  hidden
}

enum ApplicationStatus {
  submitted
  approved
  rejected
  cancelled
}

model ProgramCategory {
  id        String    @id
  name      String
  group     String
  sortOrder Int       @default(0)
  programs  Program[]
}

model Program {
  id              String               @id @default(cuid())
  title           String
  categoryId      String
  category        ProgramCategory      @relation(fields: [categoryId], references: [id])
  summary         String
  description     String
  target          String
  place           String
  startsAt        DateTime
  endsAt          DateTime
  recruitStartsAt DateTime
  recruitEndsAt   DateTime
  capacity        Int
  /// 접수·승인 상태 신청 수 (신청·취소·반려와 같은 트랜잭션에서 갱신)
  appliedCount    Int                  @default(0)
  status          PublishStatus        @default(draft)
  cancelDeadline  DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  applications    ProgramApplication[]

  @@index([status, recruitEndsAt])
}

model ProgramApplication {
  id            String            @id @default(cuid())
  /// 서버가 발급한 접수 번호 (SJYC-연도-일련번호)
  receiptNo     String            @unique
  programId     String
  program       Program           @relation(fields: [programId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantName String
  phone         String
  note          String
  status        ApplicationStatus @default(submitted)
  /// StatusHistoryEntry[]
  history       Json              @default("[]")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([programId, status])
  @@index([userId, createdAt])
}

enum ReservationStatus {
  pending
  approved
  rejected
  cancelled
}

model Space {
  id           String             @id @default(cuid())
  name         String
  floor        String
  capacity     Int
  description  String
  /// 예약 접수 여부 (휴관·점검 시 관리자가 끈다)
  reservable   Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  reservations SpaceReservation[]
}

model SpaceReservation {
  id            String            @id @default(cuid())
  spaceId       String
  space         Space             @relation(fields: [spaceId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantName String
  /// 하이픈 없는 숫자만
  phone         String
  /// 이용일 YYYY-MM-DD (KST 달력 날짜)
  date          String
  /// HH:MM
  startTime     String
  endTime       String
  headcount     Int
  purpose       String
  status        ReservationStatus @default(pending)
  reason        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([spaceId, date, status])
  @@index([userId, date])
}

enum ClubStatus {
  active
  inactive
}

enum ClubRole {
  leader
  member
}

enum ClubPostKind {
  notice
  schedule
  activity
}

enum ClubApplicationStatus {
  pending
  approved
  rejected
  cancelled
}

model Club {
  id           String            @id @default(cuid())
  name         String
  field        String
  summary      String
  description  String
  meetingInfo  String
  target       String?
  recruiting   Boolean           @default(false)
  status       ClubStatus        @default(active)
  /// MediaPhoto[] — 공식 채널 사진, 출처 포함
  photos       Json              @default("[]")
  /// ClubActivity[]
  activities   Json              @default("[]")
  sourceUrls   String[]          @default([])
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  ClubMembership[]
  posts        ClubPost[]
  applications ClubApplication[]
  managers     ClubManager[]
}

model ClubMembership {
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClubRole @default(member)
  joinedAt DateTime @default(now())

  @@id([clubId, userId])
  @@index([userId])
}

model ClubPost {
  id     String       @id @default(cuid())
  clubId String
  club   Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  kind   ClubPostKind
  title  String
  body   String
  at     DateTime     @default(now())

  @@index([clubId, at])
}

model ClubApplication {
  id            String                @id @default(cuid())
  clubId        String
  club          Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantName String
  motivation    String
  status        ClubApplicationStatus @default(pending)
  reason        String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([clubId, status])
  @@index([userId, createdAt])
}

enum NoticeCategory {
  center
  youth
  education
}

enum InquiryCategory {
  program
  space
  club
  account
  etc
}

enum InquiryStatus {
  open
  answered
}

enum MediaKind {
  photo
  video
}

model Notice {
  id          String         @id @default(cuid())
  title       String
  category    NoticeCategory
  /// 일반 텍스트 (HTML 아님)
  body        String
  status      PublishStatus  @default(draft)
  pinned      Boolean        @default(false)
  publishedAt DateTime?
  /// Attachment[]
  attachments Json           @default("[]")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, pinned, publishedAt])
}

model Faq {
  id        String          @id @default(cuid())
  category  InquiryCategory
  question  String
  answer    String
  order     Int             @default(0)
  published Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

/// 정책 문서 — key 는 PolicyKey (privacy, terms, ...)
model Policy {
  key         String    @id
  title       String
  body        String
  /// 센터가 확정본을 등록했는지
  confirmed   Boolean   @default(false)
  effectiveAt DateTime?
  updatedAt   DateTime  @updatedAt
}

/// 센터 공식 채널(SNS·유튜브)의 사진·영상 — 출처 보관
model MediaItem {
  id           String    @id @default(cuid())
  kind         MediaKind
  title        String
  url          String
  thumbnailUrl String
  sourceUrl    String
  /// YYYY-MM-DD, 확인되지 않으면 null
  date         String?
  createdAt    DateTime  @default(now())
}

model Inquiry {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName String
  category   InquiryCategory
  title      String
  body       String
  status     InquiryStatus   @default(open)
  answerBody String?
  answeredAt DateTime?
  answeredBy String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// 관리자 작업 기록 — 누가 언제 무엇을 바꿨는지
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// 행위자가 탈퇴해도 기록은 남긴다
  actorId    String?
  actorName  String
  action     String
  /// AuditEvent['targetType'] (notice, program, user, ...)
  targetType String
  targetId   String
  summary    String

  @@index([at])
}

/// 동아리별 담당자 — 센터 직원이 회원을 지정하고, 그 동아리의 운영(회원·가입·출석·소식·소개)을 맡긴다
model ClubManager {
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([clubId, userId])
  @@index([userId])
}

enum AttendanceTargetType {
  club
  program
}

enum AttendanceStatus {
  present
  late
  absent
  excused
}

enum AttendanceMethod {
  self
  manager
}

/// 출석부 한 회차 — 대상(동아리·프로그램)의 명단을 만들 때 채운다
model AttendanceSession {
  id              String               @id @default(cuid())
  targetType      AttendanceTargetType
  targetId        String
  /// 만들 때의 대상 이름
  targetName      String
  /// YYYY-MM-DD (KST)
  date            String
  title           String
  /// 본인 출석용 4자리 코드 — 열려 있을 때만
  checkInCode     String?
  checkInClosesAt DateTime?
  createdBy       String
  createdAt       DateTime             @default(now())
  records         AttendanceRecord[]

  @@index([targetType, targetId, date])
  @@index([checkInCode])
}

model AttendanceRecord {
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  status    AttendanceStatus?
  checkedAt DateTime?
  method    AttendanceMethod?
  note      String?

  @@id([sessionId, userId])
  @@index([userId])
}

model SiteSettings {
  id      String @id
  version Int
  values  Json
}

/// 가입 완료 전까지 보관하는 일회용 휴대전화 인증 요청
model SignupPhoneChallenge {
  scope String @id
  ticketHash String @unique
  data Json
  phone String
  codeHash String
  attempts Int @default(0)
  sentAt DateTime
  codeExpiresAt DateTime
  expiresAt DateTime
  @@index([expiresAt])
}
