-- 운영 변경으로 승인된 회원과 실행 주체를 한 번만 결합한다.
-- 일반 마이그레이션이나 API 시작 시에는 실행하지 않는다.
\set ON_ERROR_STOP on
BEGIN;
SET LOCAL search_path = pg_catalog, pg_temp;
SET LOCAL lock_timeout = '3s';

DO $install$
BEGIN
  IF NOT pg_has_role(current_user, (SELECT relowner FROM pg_class WHERE oid = 'public."User"'::regclass), 'USAGE') THEN
    RAISE EXCEPTION '회원 테이블 소유자 권한으로 등록 승인을 설치해야 합니다.';
  END IF;
END
$install$;

-- 이미 승인 또는 적용한 설치를 덮어쓰지 않는다.
CREATE SCHEMA sjyc_enrollment;
REVOKE ALL ON SCHEMA sjyc_enrollment FROM PUBLIC;
CREATE TABLE sjyc_enrollment.first_developer (
  singleton boolean PRIMARY KEY DEFAULT true CHECK (singleton),
  member_id text NOT NULL,
  email text NOT NULL,
  approved_by name NOT NULL DEFAULT session_user,
  approved_at timestamptz NOT NULL DEFAULT now(),
  executor regrole NOT NULL
);
CREATE TABLE sjyc_enrollment.receipt (
  singleton boolean PRIMARY KEY DEFAULT true CHECK (singleton),
  applied_at timestamptz NOT NULL DEFAULT clock_timestamp()
);
REVOKE ALL ON TABLE sjyc_enrollment.first_developer, sjyc_enrollment.receipt FROM PUBLIC;

INSERT INTO sjyc_enrollment.first_developer (member_id, email, executor)
SELECT u.id, u.email, r.oid
FROM public."User" AS u
JOIN pg_roles AS r ON r.rolname = :'executor' AND r.rolcanlogin
JOIN pg_class AS members ON members.oid = 'public."User"'::regclass
  AND pg_has_role(r.oid, members.relowner, 'USAGE')
WHERE u.id = :'member_id' AND u.email = lower(trim(:'email'))
  AND u.status = 'active' AND 'admin' = ANY(u.roles)
  AND NOT EXISTS (SELECT FROM public."User" WHERE 'developer' = ANY(roles));

DO $validate$
BEGIN
  IF NOT EXISTS (SELECT FROM sjyc_enrollment.first_developer) THEN
    RAISE EXCEPTION '승인 대상, 운영 DB 로그인 또는 기존 개발자 상태를 확인하세요.';
  END IF;
END
$validate$;

CREATE FUNCTION sjyc_enrollment.apply_first_developer() RETURNS text
LANGUAGE plpgsql SECURITY INVOKER
SET search_path = pg_catalog, pg_temp
SET lock_timeout = '3s'
AS $apply$
DECLARE
  approval sjyc_enrollment.first_developer%ROWTYPE;
BEGIN
  SELECT * INTO STRICT approval FROM sjyc_enrollment.first_developer WHERE singleton;
  IF NOT EXISTS (
    SELECT FROM pg_roles AS r JOIN pg_class AS members ON members.oid = 'public."User"'::regclass
    WHERE r.rolname = session_user AND r.oid = approval.executor
      AND pg_has_role(r.oid, members.relowner, 'USAGE')
  ) THEN
    RAISE EXCEPTION '이 변경에 승인된 운영 DB 로그인이 아닙니다.' USING ERRCODE = '42501';
  END IF;

  IF current_setting('transaction_isolation') <> 'read committed' THEN
    RAISE EXCEPTION '최신 역할을 읽을 수 있도록 READ COMMITTED에서 실행하세요.';
  END IF;

  -- 회원 역할을 변경하는 다른 트랜잭션이 있으면 먼저 끝날 때까지 기다린다.
  LOCK TABLE public."User" IN SHARE ROW EXCLUSIVE MODE;
  IF EXISTS (SELECT FROM sjyc_enrollment.receipt WHERE singleton) THEN
    RETURN 'already_applied';
  END IF;
  IF EXISTS (SELECT FROM public."User" WHERE 'developer' = ANY(roles)) THEN
    RAISE EXCEPTION '이미 개발자가 등록되어 있습니다.';
  END IF;
  UPDATE public."User"
  SET roles = array_replace(roles, 'admin'::public."Role", 'developer'::public."Role"),
      "updatedAt" = timezone('UTC', statement_timestamp())
  WHERE id = approval.member_id AND email = approval.email
    AND status = 'active' AND 'admin' = ANY(roles);
  IF NOT FOUND THEN
    RAISE EXCEPTION '승인 후 회원 정보 또는 역할이 변경되었습니다.';
  END IF;

  DELETE FROM public."Session" WHERE "userId" = approval.member_id;
  INSERT INTO public."AuditEvent" (id, "actorName", action, "targetType", "targetId", summary)
  VALUES (gen_random_uuid()::text, session_user, 'user.update', 'user', approval.member_id,
          format('최초 개발자 등록 · 최고 관리자 → 개발자 · 승인 %s · 실행 %s', approval.approved_by, session_user));
  INSERT INTO sjyc_enrollment.receipt (singleton) VALUES (true);
  RETURN 'applied';
END
$apply$;
REVOKE ALL ON FUNCTION sjyc_enrollment.apply_first_developer() FROM PUBLIC;

GRANT USAGE ON SCHEMA sjyc_enrollment TO :"executor";
GRANT SELECT ON sjyc_enrollment.first_developer, sjyc_enrollment.receipt TO :"executor";
GRANT INSERT (singleton) ON sjyc_enrollment.receipt TO :"executor";
GRANT EXECUTE ON FUNCTION sjyc_enrollment.apply_first_developer() TO :"executor";
-- 기본 ACL에서 다른 DB 계정에 운영 전용 스키마 권한을 부여하는 경우 설치를 취소한다.
DO $acl$
BEGIN
  IF EXISTS (
    SELECT FROM pg_namespace AS n
    CROSS JOIN LATERAL aclexplode(n.nspacl) AS a
    WHERE n.nspname = 'sjyc_enrollment' AND a.grantee <> n.nspowner
      AND a.grantee <> (SELECT executor::oid FROM sjyc_enrollment.first_developer)
  ) THEN
    RAISE EXCEPTION '운영 전용 스키마에 다른 DB 계정의 기본 권한이 있습니다.';
  END IF;
END
$acl$;
COMMIT;
